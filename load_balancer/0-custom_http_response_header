#!/usr/bin/env bash
# shellcheck disable=SC2154
# Configures a new Ubuntu machine with Nginx and adds a custom
# X-Served-By HTTP response header whose value is the server hostname.

apt-get update
apt-get install -y nginx

# Add the custom header into the default site's server block
sed -i "/server_name _;/a \\\tadd_header X-Served-By \"$HOSTNAME\";" /etc/nginx/sites-available/default

service nginx restart

